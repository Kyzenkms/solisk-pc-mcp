{
  "name": "pc-control-mcp-desktop",
  "version": "1.0.0",
  "description": "PC Control MCP Desktop App. Connect trusted AI clients to your Windows PC.",
  "main": "main.js",
  "author": "kyzenkms",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:unsigned-beta": "electron-builder --win --x64 -c.win.signAndEditExecutable=false && node stamp-icon.js && electron-builder --win --x64 --prepackaged dist/win-unpacked",
    "build:msi": "node build-msi.js",
    "dev": "electron . --dev"
  },
  "build": {
    "appId": "com.pccontrolmcp.app",
    "productName": "PC Control MCP",
    "copyright": "PC Control MCP",
    "files": [
      "**/*",
      "!_ui-backup*/**",
      "!_backup*/**",
      "!**/_ui-backup*",
      "!**/_backup*"
    ],
    "forceCodeSigning": false,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "msi": {
      "upgradeCode": "a62da5de-6cee-4b0a-a037-4f377186a61e",
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "../",
        "to": "server",
        "filter": [
          "index.js",
          "app.js",
          "package.json",
          "lib/**",
          "tools/**",
          "relay-server/scopes.js",
          "pc-control-headless/web/**",
          "desktop-app/renderer/**",
          "node_modules/**"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "36.4.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "dependencies": {
    "ws": "^8.21.0"
  }
}
