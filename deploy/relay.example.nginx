# PC Control MCP — example Nginx reverse proxy for the relay server
#
# Replace YOUR_DOMAIN with the domain you point at your VPS,
# then obtain a certificate:
#
#   sudo certbot --nginx -d YOUR_DOMAIN
#
# Save as /etc/nginx/sites-available/YOUR_DOMAIN, symlink into
# sites-enabled/, then: sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name YOUR_DOMAIN;

    location /.well-known/acme-challenge/ {
        root /var/www/mcp-acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name YOUR_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Relay listens on loopback only; Nginx terminates TLS.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # Required for the WebSocket upgrade the desktop agent uses
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Long timeouts keep idle agent sockets alive
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }
}
