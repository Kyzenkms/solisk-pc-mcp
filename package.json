{
  "name": "solisk",
  "version": "1.0.2",
  "mcpName": "io.github.Kyzenkms/solisk-pc-mcp",
  "description": "MCP server giving AI clients secure control of your PC \u2014 CLI-first on Windows, Linux and macOS, Windows GUI optional.",
  "main": "index.js",
  "type": "commonjs",
  "bin": {
    "solisk": "pc-control-headless/bin/pc-control.js",
    "pc-control": "pc-control-headless/bin/pc-control.js",
    "pc-control-mcp": "app.js"
  },
  "files": [
    "assets/brand/readme/",
    "pc-control-headless/bin/",
    "pc-control-headless/package.json",
    "pc-control-headless/server.js",
    "pc-control-headless/stdio.js",
    "pc-control-headless/tools.js",
    "pc-control-headless/tools/",
    "pc-control-headless/web/",
    "pc-control-headless/config.example.json",
    "lib/",
    "tools/",
    "relay-server/scopes.js",
    "index.js",
    "app.js"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node app.js",
    "setup": "node app.js --setup",
    "dev": "node index.js --mode http",
    "stdio": "node index.js --mode=stdio",
    "http": "node index.js --mode=http",
    "both": "node index.js --mode=both",
    "tunnel": "node tunnel.js start",
    "tunnel:cf": "powershell -Command \"& 'C:\\Program Files (x86)\\cloudflared\\cloudflared.exe' tunnel --url http://localhost:3000\"",
    "relay": "node -e \"require('./lib/relay-client').startRelayClient(require('./lib/security').config)\"",
    "inspect": "npx @modelcontextprotocol/inspector node index.js --mode stdio",
    "inspect:http": "npx @modelcontextprotocol/inspector http://localhost:3000/mcp",
    "test": "node test/unit/permissions.test.js && node test/unit/security.test.js && node test/unit/network_offline.test.js && node test/e2e.test.js && npm --prefix relay-server test",
    "build:exe": "pkg app.js --target node18-win-x64 --output dist/pc-control-mcp.exe --compress GZip",
    "test:live": "node test-live.js"
  },
  "pkg": {
    "assets": [
      "tools/**/*",
      "lib/**/*",
      "index.js"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-tools",
    "pc-control",
    "chatgpt",
    "chatgpt-connector",
    "claude",
    "claude-ai",
    "windows",
    "agent",
    "remote-mcp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.18.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "pkg": "^5.8.1"
  },
  "directories": {
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kyzenkms/solisk-pc-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Kyzenkms/solisk-pc-mcp/issues"
  },
  "homepage": "https://github.com/Kyzenkms/solisk-pc-mcp#readme"
}
